  {
   "key": "speaker.entity",
   "value": "الكيان الأزرق"
  },
  {
   "key": "speaker.saqr",
   "value": "صقر"
  },
  {
   "key": "story.intro.1",
   "value": "في أعماق السماء، رجلٌ معلّقٌ بحبالٍ من نور..."
  },
  {
   "key": "story.intro.2",
   "value": "تنقطع الحبال، فيسقط صقر في قلب الصحراء، وقد نسي كل شيء."
  },
  {
   "key": "story.intro.3",
   "value": "تلاحقه مخلوقات الجن، تضربه وترميه من بعيد، وهو يهرب بما بقي له من قوة."
  },
  {
   "key": "story.intro.4",
   "value": "يدخل كهفاً مظلماً بصعوبة، وتقترب الوحوش..."
  },
  {
   "key": "story.intro.5",
   "value": "كفى يا فتيان! المخلوقات تتساءل: من هذا؟"
  },
  {
   "key": "story.intro.6",
   "value": "تهجم الجن عليه، فيضرب الكيان الأزرق الأرض ضربةً زلزلت المكان."
  },
  {
   "key": "story.intro.7",
   "value": "أوف يا فتيان... لقد جرحتم مشاعري."
  },
  {
   "key": "story.intro.8",
   "value": "تختفي الجن في لمح البصر، ويبقى صقر وحده يلتقط أنفاسه."
  },
  {
   "key": "story.dark.1",
   "value": "هذه قوتي تسري في عروقك يا صقر. استمتع بها... ما دامت تنفعني."
  },
  {
   "key": "story.end.title",
   "value": "نهاية الفصل الأول"
  },
  {
   "key": "story.end.1",
   "value": "سقط المارد، لكن الكيان الأزرق يراقب من الظلام."
  },
  {
   "key": "story.end.2",
   "value": "أحسنت يا صقر. لكن هذه كانت البداية فقط."
  },
  {
   "key": "story.end.3",
   "value": "يتبع في الفصل الثاني: صحراء البرزخ"
  },
  {
   "key": "settings.title",
   "value": "الإعدادات"
  },
  {
   "key": "settings.music",
   "value": "الموسيقى"
  },
  {
   "key": "settings.sfx",
   "value": "المؤثرات"
  },
  {
   "key": "settings.reset",
   "value": "حذف التقدم"
  },
  {
   "key": "settings.reset_confirm",
   "value": "هل تريد حذف كل تقدمك؟"
  },
  {
   "key": "story.intro_orb.1",
   "value": "يلمس الكيان الأزرق صدر صقر بإصبعه، فتدخل جسده كرةٌ زرقاء صغيرة."
  },
  {
   "key": "story.ch2_start.1",
   "value": "يستيقظ صقر في أرضٍ لا تشبه شيئاً عرفه: رمالٌ رمادية وسماءٌ بلا شمس."
  },
  {
   "key": "story.ch2_start.2",
   "value": "أين أنا؟ ولماذا تحرقني هذه الكرة الزرقاء في صدري؟"
  },
  {
   "key": "story.ch2_start.3",
   "value": "يقترب شيخٌ عجوز متّكئ على عصا، وعيناه تلمعان كالجمر."
  },
  {
   "key": "story.ch2_start.4",
   "value": "هذه صحراء البرزخ يا بني، الأرض الميتة بين عالم البشر وعالم الجن."
  },
  {
   "key": "story.ch2_start.5",
   "value": "أنا سالم. كنتُ محارباً قبل أن أصير روحاً تائهة، وأعرف ما تحمله في صدرك."
  },
  {
   "key": "story.ch2_start.6",
   "value": "أتعرف من أنا؟ لا أذكر حتى اسمي!"
  },
  {
   "key": "story.ch2_start.7",
   "value": "اسمك صقر. أما الباقي فستجده بين الموجات... إن بقيتَ حياً."
  },
  {
   "key": "story.mem_1.1",
   "value": "يتوهج بصر صقر، فيرى نفسه طفلاً يركض بين النخيل خلف فتىً يشبهه تماماً."
  },
  {
   "key": "story.mem_1.2",
   "value": "أسرع يا صقر! سأسبقك إلى البئر!"
  },
  {
   "key": "story.mem_1.3",
   "value": "من هذا الفتى؟ وجهه يتلاشى كلما حاولتُ النظر إليه."
  },
  {
   "key": "story.mem_2.1",
   "value": "شيخ القبيلة يهمس في ليلةٍ بلا قمر، والتوأمان يصغيان."
  },
  {
   "key": "story.mem_2.2",
   "value": "في كل جيلٍ يولد توأمان، أحدهما يحمل نار الخلود، ولا تشتعل إلا بفراق أخيه."
  },
  {
   "key": "story.mem_2.3",
   "value": "فراق أخيه... لماذا يخفق قلبي هكذا؟"
  },
  {
   "key": "story.ch2_end.1",
   "value": "سقط العملاق، لكن قوتك تكبر يا صقر، وهذا هو الخطر."
  },
  {
   "key": "story.ch2_end.2",
   "value": "الكرة الزرقاء طاقةٌ ممنوعة. كلما استعملتَها اقتربتَ من أن تصير جنّياً."
  },
  {
   "key": "story.ch2_end.3",
   "value": "وإن لم أستعملها؟ سأموت في الموجة التالية."
  },
  {
   "key": "story.ch2_end.4",
   "value": "وهذا هو الفخ الذي نُصب لك. خذ هذه العين، فهي تُنبّهك قبل أن تضيع."
  },
  {
   "key": "story.ch2_end.5",
   "value": "يضع الشيخ تميمةً في يد صقر، ثم يتلاشى كغبارٍ في الريح."
  },
  {
   "key": "story.ch3_start.1",
   "value": "يعبر صقر حدود البرزخ، فتظهر له قريةٌ عربيةٌ مهدّمة وأسوارٌ تهاوت."
  },
  {
   "key": "story.ch3_start.2",
   "value": "قف! من أنت؟ هل أنت منهم؟"
  },
  {
   "key": "story.ch3_start.3",
   "value": "لا. أنا صقر، ولا أذكر من أكون."
  },
  {
   "key": "story.ch3_start.4",
   "value": "أنا نورة، ومعي من نجا من القرية. إن أردتَ حمايتنا فأعد بناء الحصن."
  },
  {
   "key": "story.ch3_start.5",
   "value": "سأبنيه، وسأقف عند بابه حتى آخر نَفَس."
  },
  {
   "key": "story.mem_3.1",
   "value": "ليلةٌ بلا قمر. صقر يقف وحيداً أمام مارد عظيم متوّج بالنار."
  },
  {
   "key": "story.mem_3.2",
   "value": "تريد الخلود؟ لكل شيءٍ ثمن: أن تخسر أعزّ ما تملك."
  },
  {
   "key": "story.mem_3.3",
   "value": "يصمت صقر طويلاً... والتوأم الآخر يراقب من بعيد."
  },
  {
   "key": "story.mem_3.4",
   "value": "ما هذا الذي فعلتُه؟ لماذا لا أريد أن أتذكر؟"
  },
  {
   "key": "story.ch3_betrayal.1",
   "value": "تهبط الظلال الزرقاء من سماء الليل، أتباع الكيان الأزرق."
  },
  {
   "key": "story.ch3_betrayal.2",
   "value": "جئنا نأخذ ما هو لسيدنا. القوة التي في صدرك ليست لك."
  },
  {
   "key": "story.ch3_betrayal.3",
   "value": "إنها تحرقني، وما زلتُ لا أعرف لمن هي!"
  },
  {
   "key": "story.ch3_betrayal.4",
   "value": "اثبت يا صقر! الحصن معك!"
  },
  {
   "key": "story.mem_4.1",
   "value": "حبالٌ من نورٍ تلتفّ حول جسدٍ يصرخ، ثم ترتفع به إلى السماء."
  },
  {
   "key": "story.mem_4.2",
   "value": "ستبقى معلّقاً سنةً بعد سنة، حتى تتذكر ما فعلتَ بي."
  },
  {
   "key": "story.mem_4.3",
   "value": "هذه الحبال... هي نفسها التي كنتُ معلّقاً بها!"
  },
  {
   "key": "story.ch3_end.1",
   "value": "تنهار ملكة السعالي وتتبدد الظلال، وعلى السور حجرٌ منقوشٌ بنورٍ أزرق."
  },
  {
   "key": "story.ch3_end.2",
   "value": "أحسنتَ يا صقر. يمتعني أن أراك تقاتل. تعالَ إلى برج قاف... إن تجرأتَ."
  },
  {
   "key": "story.ch3_end.3",
   "value": "برج قاف؟ لا أحد عاد منه."
  },
  {
   "key": "story.ch3_end.4",
   "value": "سأعود. ولي حسابٌ مع صاحب هذا الصوت."
  },
  {
   "key": "story.ch4_start.1",
   "value": "جبال قاف تحجب السماء، وفي قمتها برجٌ أزرق يتوهج كقلبٍ ينبض."
  },
  {
   "key": "story.ch4_start.2",
   "value": "كل خطوةٍ أقرب إليه تُشعل الطاقة في صدري أكثر."
  },
  {
   "key": "story.ch4_start.3",
   "value": "ومع كل موجة تضعف قبضة النسيان على ذاكرته، وتشتد قبضة الجن عليه."
  },
  {
   "key": "story.mem_5.1",
   "value": "فتىً يشبه صقراً ينظر إليه نظرةً أخيرة في ضوء النار."
  },
  {
   "key": "story.mem_5.2",
   "value": "سأنتظرك يا أخي، مهما طال الزمن."
  },
  {
   "key": "story.mem_5.3",
   "value": "عقاب... اسمه عقاب. أخي!"
  },
  {
   "key": "story.ch4_twist.1",
   "value": "أخيراً وصلتَ. ألا تعرف وجهي يا صقر؟"
  },
  {
   "key": "story.ch4_twist.2",
   "value": "ينزع الكيان غطاء رأسه، فإذا هو وجه صقر نفسه بعينين زرقاوين."
  },
  {
   "key": "story.ch4_twist.3",
   "value": "عقاب... أخي."
  },
  {
   "key": "story.ch4_twist.4",
   "value": "بعتَني للظلام لأجل خلودك. واليوم أريدك أن تعرف كل ما عرفتُه."
  },
  {
   "key": "story.ch4_twist.5",
   "value": "كنتُ شاباً أحمق ولم أعرف ما أفعل. سامحني."
  },
  {
   "key": "story.ch4_twist.6",
   "value": "السماح يحتاج إلى دمٍ يا أخي. قاتل!"
  },
  {
   "key": "story.final_choice.1",
   "value": "يسقط عقاب على ركبتيه، وتخرج الطاقة الزرقاء من صدر صقر وتدور بينهما."
  },
  {
   "key": "story.final_choice.2",
   "value": "الطاقة تحتاج إلى مضيف. إما أنا أو أنت."
  },
  {
   "key": "story.final_choice.3",
   "value": "وعلى صقر أن يختار."
  },
  {
   "key": "story.end_sacrifice.1",
   "value": "يمدّ صقر يده ويستقبل الطاقة كلها في صدره."
  },
  {
   "key": "story.end_sacrifice.2",
   "value": "اذهب يا أخي. كفاك ما عانيتَ."
  },
  {
   "key": "story.end_sacrifice.3",
   "value": "يتحرر عقاب، ويتلاشى صقر في ضوءٍ أزرق هادئ، وتعود الشمس إلى صحراء البرزخ."
  },
  {
   "key": "story.end_sacrifice.4",
   "value": "ويُحكى في القرى أن صقراً حمى الأرض... وأن عقاباً ما زال يحرس ذكراه."
  },
  {
   "key": "story.end_power.1",
   "value": "يمسك صقر الطاقة بكلتا يديه ويسحقها في صدره."
  },
  {
   "key": "story.end_power.2",
   "value": "لا يا أخي... ما كنتَ لتفعلها!"
  },
  {
   "key": "story.end_power.3",
   "value": "يسقط عقاب رماداً، ويرتفع صقر ملكاً على عرش الجن."
  },
  {
   "key": "story.end_power.4",
   "value": "وما عاد أحدٌ في القرى يذكر اسمه إلا بالخوف."
  },
